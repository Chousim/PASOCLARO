# Referencia de entorno para PasoClaro Flutter (sin claves ni API keys en Flutter).
# GEMINI_API_KEY vive unicamente en el servidor FastAPI (BackEnd/.env o Render).
#
# Ejemplos para correr la app apuntando al backend:
#   Emulador Android:   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
#   Celular por Wi-Fi:  flutter run --dart-define=API_BASE_URL=http://192.168.1.50:8000
#   Produccion Render:  flutter run --dart-define=API_BASE_URL=https://pasoclaro.onrender.com

API_BASE_URL=https://pasoclaro.onrender.com
